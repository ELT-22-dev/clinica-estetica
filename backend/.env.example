NODE_ENV=development
PORT=3000

# Postgres connection string (no EasyPanel, use o service name do Postgres criado no projeto)
DATABASE_URL=postgresql://user:password@localhost:5432/clinica_estetica?schema=public

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por virgula
CORS_ORIGIN=http://localhost:5173
